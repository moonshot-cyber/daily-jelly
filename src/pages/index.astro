---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getCollection } from 'astro:content';
import { SITE, PRODUCTS, GUIDE_PRODUCTS } from '../lib/config';
import ProductImage from '../components/ProductImage.astro';

const latestGuides = (await getCollection('guides', (g) => !g.data.draft)).sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
).slice(0, 6);
const heroProduct = PRODUCTS[0];
const amazonProduct = GUIDE_PRODUCTS.find(p => p.isAmazon);
---

<Base activeNav="home" image={heroProduct.image}>
  <div class="hero">
    <div class="hero__copy">
      <p class="hero-eyebrow">{SITE.tagline}</p>
      <h1>A new way to take collagen —<br /><span style="color: var(--accent);">no water needed.</span></h1>
      <p>
        Most collagen in the UK comes as gummies, powders, or tablets. In Korea, the format
        people actually reach for is a jelly stick: a ready-to-eat pouch you tear and drink
        or eat directly, no mixing or swallowing required. We're tracking how — and whether —
        that format makes it to UK shelves.
      </p>
    </div>
    <ProductImage
      name={heroProduct.name}
      retailer={heroProduct.retailer}
      image={heroProduct.image}
      href={heroProduct.href}
      size="hero"
      priority
    />
  </div>

  <div class="claim-box">
    <strong>Vitamin C contributes to normal collagen formation for the normal function of skin.</strong>
    This is the only collagen-related health claim authorised for use in the UK/EU. Any product
    claiming to "boost," "restore," or "reverse" skin ageing is going beyond what's currently permitted —
    treat those claims with caution wherever you see them.
  </div>

  <div style="margin: 28px 0;">
    <a href="/where-to-buy" class="btn">See where to buy jelly sticks in the UK →</a>
    <p style="font-size: 13px; color: var(--text-muted); margin: 10px 0 0;">Compare BB LAB, FOODOLOGY, Cloo9, YIXO, NOW &amp; Amazon UK — delivery paths compared.</p>
    <p style="font-size: 13px; color: var(--text-muted); margin: 6px 0 0;">New to collagen supplements generally? Start with our <a href="/collagen">full collagen guide</a> — formats, types, and doses explained.</p>
  </div>

  {amazonProduct && (
    <div class="amazon-feature">
      <ProductImage
        name={amazonProduct.name}
        retailer={amazonProduct.imageRetailer}
        image={amazonProduct.image}
        href={amazonProduct.ukPath[0].href}
      />
      <div class="amazon-feature__body">
        <p class="amazon-feature__eyebrow">Available on Amazon UK</p>
        <p class="amazon-feature__name">{amazonProduct.name}</p>
        <p class="amazon-feature__meta">{amazonProduct.priceGBP} · {SITE.amazonDisclosure}</p>
        <a class="btn" href={amazonProduct.ukPath[0].href} target="_blank" rel="noopener sponsored">Check on Amazon UK →</a>
      </div>
    </div>
  )}

  <EmailCapture compact />

  <h2 style="font-size: 22px; margin: 8px 0 16px;">Start here</h2>
  <div>
    {latestGuides.map(guide => (
      <GuideCard slug={guide.slug} title={guide.data.title} excerpt={guide.data.excerpt} readTime={guide.data.readTime} />
    ))}
  </div>
  <p style="margin: 20px 0 0;"><a href="/guides" class="btn btn--outline">See all guides →</a></p>
</Base>
