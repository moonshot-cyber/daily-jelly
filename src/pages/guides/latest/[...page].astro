---
import Base from '../../../layouts/Base.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const guides = (await getCollection('guides', (g) => !g.data.draft)).sort(
    (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
  );
  return paginate(guides, { pageSize: 10 });
}

const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? 'All Guides — Newest First' : `All Guides — Page ${page.currentPage}`;
---

<Base title={pageTitle} description="Every guide on Daily Jelly, newest first." activeNav="guides">
  <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--text-muted); margin-bottom: 14px;">
    <a href="/" style="color: var(--text-muted);">Home</a> /
    <a href="/guides" style="color: var(--text-muted);">Guides</a> /
    <span>All, newest first</span>
  </nav>
  <h1 style="font-size: 30px; margin: 0 0 8px;">All Guides, Newest First</h1>
  <p style="color: var(--text-muted); margin: 0 0 28px; font-size: 15px; max-width: 500px;">
    Prefer to browse by topic? See <a href="/guides">guides grouped by cluster</a> instead.
  </p>

  <div>
    {page.data.map(guide => (
      <GuideCard slug={guide.slug} title={guide.data.title} excerpt={guide.data.excerpt} readTime={guide.data.readTime} />
    ))}
  </div>

  {page.lastPage > 1 && (
    <nav aria-label="Guides pagination" style="display: flex; justify-content: space-between; align-items: center; margin: 32px 0 8px;">
      {page.url.prev ? <a href={page.url.prev} class="btn btn--outline">← Newer</a> : <span />}
      <span style="font-size: 13px; color: var(--text-muted);">Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next} class="btn btn--outline">Older →</a> : <span />}
    </nav>
  )}
</Base>
