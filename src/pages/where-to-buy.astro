---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import ProductGuideCard from '../components/ProductGuideCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { GUIDE_PRODUCTS, SITE, EBAY_LISTINGS } from '../lib/config';

const quickPicks = [
  { key: 'overall', label: 'Best overall' },
  { key: 'uk-path', label: 'Best for UK retailer choice' },
  { key: 'vegan', label: 'Best vegan' },
  { key: 'amazon', label: "Best if you're already on Amazon" },
].map(qp => ({ ...qp, product: GUIDE_PRODUCTS.find(p => p.quickPick === qp.key) }));

const pageURL = new URL('/where-to-buy', SITE.url).toString();

const productSchemas = GUIDE_PRODUCTS.map(p => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.bestFor,
  brand: { '@type': 'Brand', name: p.brand },
  image: p.image,
  offers: p.priceLowGBP === p.priceHighGBP
    ? {
        '@type': 'Offer',
        price: p.priceLowGBP,
        priceCurrency: 'GBP',
        url: p.ukPath[0].href,
        seller: { '@type': 'Organization', name: p.ukPath[0].name },
      }
    : {
        '@type': 'AggregateOffer',
        lowPrice: p.priceLowGBP,
        highPrice: p.priceHighGBP,
        priceCurrency: 'GBP',
        offerCount: p.ukPath.length,
        url: p.ukPath[0].href,
      },
  ...(p.aggregateRating ? {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: p.aggregateRating.ratingValue,
      reviewCount: p.aggregateRating.reviewCount,
    },
  } : {}),
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Where to Buy', item: pageURL },
  ],
};

// Every answer here restates a fact already verified and cited elsewhere on
// the site (product detail cards, the FAQ page) — nothing new is asserted.
const faqs = [
  {
    q: 'Which collagen jelly stick has the highest dose?',
    a: "Cloo9's Collagen Jelly, at 5,000mg of marine collagen per stick as stated by the brand — the highest labelled dose of the six sticks we compare, though also the most expensive per stick (~£2.29).",
  },
  {
    q: 'Is there a UK-based brand I can buy directly from?',
    a: 'Yes — YIXO is a UK-based brand selling direct from its own site (yixo.co.uk), which means the fastest, simplest delivery of any option on this list, alongside the Amazon UK option.',
  },
  {
    q: 'Can I buy a collagen jelly stick on Amazon UK?',
    a: "Yes — HAMCHOROK Rg+ Pomegranate Collagen Jelly Stick is available on Amazon UK with Prime-speed delivery and Amazon's own returns process. It's also the most-reviewed product we track, with 727 ratings at 4.4 stars at time of writing.",
  },
  {
    q: 'Do I have to pay customs or VAT ordering collagen jelly sticks from Korea?',
    a: "Possibly. Orders from outside the UK can attract import VAT, and above certain value thresholds, customs duty as well. EU-based retailers generally have simpler, more predictable customs handling than orders shipped directly from Korea — check the retailer's own shipping and customs page before ordering.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = [...productSchemas, breadcrumbSchema, faqSchema];
---

<Base
  title="Where to Buy Collagen Jelly Sticks in the UK"
  description="Compare BB LAB, FOODOLOGY, Cloo9, YIXO, NOW Foods and HAMCHOROK jelly sticks — UK delivery paths, pack maths, and an affiliate disclosure."
  activeNav="where-to-buy"
  image={GUIDE_PRODUCTS[0].image}
  jsonLd={jsonLd}
>
  <nav aria-label="Breadcrumb" style="font-size: 13px; color: var(--text-muted); margin-bottom: 14px;">
    <a href="/" style="color: var(--text-muted);">Home</a> / <span>Where to Buy</span>
  </nav>
  <p style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 0 0 10px;">Guide · updated September 2026</p>
  <h1 style="font-size: 30px; margin: 0 0 10px; max-width: 620px;">Where to buy collagen jelly sticks in the UK</h1>
  <p style="color: var(--text-muted); margin: 0 0 20px; font-size: 15px; max-width: 560px;">
    Most UK collagen is still gummies, powders, or tablets. True ready-to-eat jelly sticks — tear-open
    pouches, no water needed — are easier to find from Korea-focused shops, a handful of UK DTC brands,
    and (for one vetted pick) Amazon UK. Here's a straight comparison of six real, currently-available
    sticks.
  </p>

  <Disclosure />
  <p style="font-size: 13px; color: var(--text-muted); margin: -18px 0 24px;"><strong>{SITE.amazonDisclosure}</strong></p>
  <p style="font-size: 13px; color: var(--text-muted); margin: 0 0 8px;">Just want the short version? See our <a href="/guides/best-collagen-jelly-sticks-uk">best collagen jelly sticks UK — quick picks</a>.</p>
  <p style="font-size: 13px; color: var(--text-muted); margin: 0 0 24px;">Wondering if jelly sticks are actually good value? See our <a href="/collagen-price-index">UK collagen price index</a> — cost per 1,000mg across sachets, powders, and jelly sticks.</p>

  <h2 style="font-size: 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 28px 0 12px;">Quick picks</h2>
  <div class="quick-picks">
    {quickPicks.map(qp => qp.product && (
      <a class="quick-pick" href={`#${qp.product.slug}`}>
        <div class="quick-pick__label">{qp.label}</div>
        <div class="quick-pick__name">{qp.product.name}</div>
      </a>
    ))}
  </div>

  <h2 style="font-size: 20px; margin: 8px 0 12px;">Compare at a glance</h2>
  <div class="table-scroll">
    <table class="compare-table">
      <thead>
        <tr>
          <th>Brand / product</th>
          <th>Pack</th>
          <th>Type</th>
          <th>Price</th>
          <th>Per serving</th>
          <th>UK delivery path</th>
          <th>Best for</th>
        </tr>
      </thead>
      <tbody>
        {GUIDE_PRODUCTS.map(p => (
          <tr>
            <td><a href={`#${p.slug}`}>{p.name}</a></td>
            <td>{p.packSize}</td>
            <td>{p.type}</td>
            <td>{p.priceGBP}</td>
            <td>{p.pricePerServing}</td>
            <td>{p.ukPath.map(u => u.name).join(' / ')}</td>
            <td>{p.bestFor}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p style="font-size: 12px; color: var(--text-muted); margin: -20px 0 32px;">Prices are indicative bands checked September 2026 — retailers change prices often, so check the live price before buying.</p>

  <h2 style="font-size: 20px; margin: 8px 0 20px;">The six sticks, in detail</h2>
  {GUIDE_PRODUCTS.map(p => <ProductGuideCard {...p} />)}

  <h2 style="font-size: 20px; margin: 32px 0 12px;">Also available on eBay</h2>
  <p style="font-size: 15px; color: var(--text-muted); max-width: 560px; margin: 0 0 16px;">
    eBay has a lot of jelly-stick listings, but most are private sellers with no returns policy — fine
    for some buyers, but it doesn't meet the bar we use for the six sticks above. Here's the one listing
    we found from a registered business seller with a real returns policy:
  </p>
  <div class="post-body" style="font-size: 15px;">
    <ul>
      {EBAY_LISTINGS.map(l => (
        <li>
          <a href={l.href} target="_blank" rel="noopener sponsored"><strong>{l.name}</strong></a> — {l.priceGBP}.
          Sold by {l.seller}.
        </li>
      ))}
    </ul>
  </div>

  <h2 style="font-size: 20px; margin: 32px 0 12px;">How do we choose which sticks to feature?</h2>
  <div class="post-body" style="font-size: 15px;">
    <ul>
      <li>Must be a ready-to-eat jelly stick — not a powder, gummy, or topical cream</li>
      <li>A clear UK purchase path: a UK site, a UK stockist, or reliable ship-to-UK</li>
      <li>Transparent dose labelling is preferred, and we say so plainly when we can't confirm one</li>
      <li>We skip unverified Amazon third-party listings with thin reviews or unclear sellers — but we do link Amazon UK when a listing is a genuine ready-to-eat jelly stick with a real seller track record and a usable UK delivery path</li>
      <li>Prices are bands, not live feeds — always re-check before buying</li>
    </ul>
  </div>

  <div class="claim-box">
    <strong>Not on this list (for now):</strong> unverified Amazon listings from unbranded or brand-new
    sellers with no review history, topical "collagen jelly cream" (that's a skincare product, not
    something you eat), powder sticks you mix with water, and retailers that don't reliably ship to
    the UK.
  </div>

  <h2 style="font-size: 20px; margin: 32px 0 12px;">Sticks vs. gummies</h2>
  <p style="font-size: 15px; color: var(--text-muted); max-width: 560px; margin: 0 0 8px;">
    If you're not sure the format is worth switching for, read our full breakdown of how jelly sticks
    actually compare to the gummies and powders already on UK shelves — convenience, dosing, and price
    per serving, side by side.
  </p>
  <p style="margin: 0 0 8px;"><a href="/guides/jelly-sticks-vs-gummies-powders">Jelly Sticks vs Gummies vs Powders →</a></p>
  <p style="margin: 0 0 32px;"><a href="/guides/cutting-jelly-vs-collagen-jelly">Confused by cutting jelly vs collagen jelly? Read the difference →</a></p>

  <h2 style="font-size: 20px; margin: 32px 0 16px;">Common questions</h2>
  <div>
    {faqs.map(f => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
  </div>

  <div class="disclosure">
    <strong>A reminder on claims:</strong> the only collagen-related health claim authorised in the UK/EU
    is that Vitamin C contributes to normal collagen formation for the normal function of skin. Daily
    Jelly is an editorial guide, not a manufacturer — this page is not medical advice, and food
    supplements are not a substitute for a varied and balanced diet.
  </div>

  <EmailCapture
    title="Get UK stock & price alerts"
    body="One email when a new UK retailer stocks jelly sticks, or when a featured product drops in price. No spam, unsubscribe any time."
  />
</Base>
