---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import ProductGuideCard from '../components/ProductGuideCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { GUIDE_PRODUCTS, SITE } from '../lib/config';

const quickPicks = [
  { key: 'overall', label: 'Best overall' },
  { key: 'uk-path', label: 'Best for UK retailer choice' },
  { key: 'vegan', label: 'Best vegan' },
  { key: 'amazon', label: "Best if you're already on Amazon" },
].map(qp => ({ ...qp, product: GUIDE_PRODUCTS.find(p => p.quickPick === qp.key) }));
---

<Base
  title="Where to Buy Collagen Jelly Sticks in the UK"
  description="Compare BB LAB, FOODOLOGY, Cloo9, YIXO, NOW Foods and HAMCHOROK jelly sticks — UK delivery paths, pack maths, and an affiliate disclosure."
  activeNav="where-to-buy"
>
  <p style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 0 0 10px;">Guide · updated September 2026</p>
  <h1 style="font-size: 30px; margin: 0 0 10px; max-width: 620px;">Where to buy collagen jelly sticks in the UK</h1>
  <p style="color: var(--text-muted); margin: 0 0 20px; font-size: 15px; max-width: 560px;">
    Most UK collagen is still gummies, powders, or tablets. True ready-to-eat jelly sticks — tear-open
    pouches, no water needed — are easier to find from Korea-focused shops, a handful of UK DTC brands,
    and (for one vetted pick) Amazon UK. Here's a straight comparison of six real, currently-available
    sticks.
  </p>

  <Disclosure />
  <p style="font-size: 13px; color: var(--text-muted); margin: -18px 0 24px;"><strong>{SITE.amazonDisclosure}</strong></p>

  <h2 style="font-size: 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 28px 0 12px;">Quick picks</h2>
  <div class="quick-picks">
    {quickPicks.map(qp => qp.product && (
      <a class="quick-pick" href={`#${qp.product.slug}`}>
        <div class="quick-pick__label">{qp.label}</div>
        <div class="quick-pick__name">{qp.product.name}</div>
      </a>
    ))}
  </div>

  <h2 style="font-size: 20px; margin: 8px 0 12px;">Compare at a glance</h2>
  <div class="table-scroll">
    <table class="compare-table">
      <thead>
        <tr>
          <th>Brand / product</th>
          <th>Pack</th>
          <th>Type</th>
          <th>Price</th>
          <th>Per serving</th>
          <th>UK delivery path</th>
          <th>Best for</th>
        </tr>
      </thead>
      <tbody>
        {GUIDE_PRODUCTS.map(p => (
          <tr>
            <td><a href={`#${p.slug}`}>{p.name}</a></td>
            <td>{p.packSize}</td>
            <td>{p.type}</td>
            <td>{p.priceGBP}</td>
            <td>{p.pricePerServing}</td>
            <td>{p.ukPath.map(u => u.name).join(' / ')}</td>
            <td>{p.bestFor}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p style="font-size: 12px; color: var(--text-muted); margin: -20px 0 32px;">Prices are indicative bands checked September 2026 — retailers change prices often, so check the live price before buying.</p>

  <h2 style="font-size: 20px; margin: 8px 0 20px;">The six sticks, in detail</h2>
  {GUIDE_PRODUCTS.map(p => <ProductGuideCard {...p} />)}

  <h2 style="font-size: 20px; margin: 32px 0 12px;">How we choose</h2>
  <div class="post-body" style="font-size: 15px;">
    <ul>
      <li>Must be a ready-to-eat jelly stick — not a powder, gummy, or topical cream</li>
      <li>A clear UK purchase path: a UK site, a UK stockist, or reliable ship-to-UK</li>
      <li>Transparent dose labelling is preferred, and we say so plainly when we can't confirm one</li>
      <li>We skip unverified Amazon third-party listings with thin reviews or unclear sellers — but we do link Amazon UK when a listing is a genuine ready-to-eat jelly stick with a real seller track record and a usable UK delivery path</li>
      <li>Prices are bands, not live feeds — always re-check before buying</li>
    </ul>
  </div>

  <div class="claim-box">
    <strong>Not on this list (for now):</strong> unverified Amazon listings from unbranded or brand-new
    sellers with no review history, topical "collagen jelly cream" (that's a skincare product, not
    something you eat), powder sticks you mix with water, and retailers that don't reliably ship to
    the UK.
  </div>

  <h2 style="font-size: 20px; margin: 32px 0 12px;">Sticks vs. gummies</h2>
  <p style="font-size: 15px; color: var(--text-muted); max-width: 560px; margin: 0 0 8px;">
    If you're not sure the format is worth switching for, read our full breakdown of how jelly sticks
    actually compare to the gummies and powders already on UK shelves — convenience, dosing, and price
    per serving, side by side.
  </p>
  <p style="margin: 0 0 32px;"><a href="/guides/jelly-sticks-vs-gummies-powders">Jelly Sticks vs Gummies vs Powders →</a></p>

  <div class="disclosure">
    <strong>A reminder on claims:</strong> the only collagen-related health claim authorised in the UK/EU
    is that Vitamin C contributes to normal collagen formation for the normal function of skin. Daily
    Jelly is an editorial guide, not a manufacturer — this page is not medical advice, and food
    supplements are not a substitute for a varied and balanced diet.
  </div>

  <EmailCapture
    title="Get UK stock & price alerts"
    body="One email when a new UK retailer stocks jelly sticks, or when a featured product drops in price. No spam, unsubscribe any time."
  />
</Base>
