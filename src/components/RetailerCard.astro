---
interface Props {
  name: string;
  blurb: string;
  href: string;
  tag: string;
}
const { name, blurb, href, tag } = Astro.props;
---

<div class="retailer-card">
  <div class="retailer-card__body">
    <div class="retailer-card__title">
      <h3>{name}</h3>
      <span class="tag tag--accent">{tag}</span>
    </div>
    <p>{blurb}</p>
  </div>
  <div class="retailer-card__cta">
    <a class="btn" href={href} target="_blank" rel="noopener sponsored">Shop {name} →</a>
  </div>
</div>
